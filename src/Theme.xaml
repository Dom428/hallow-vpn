<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:HallowVPN;assembly=HallowVPN">
    <!-- Hallow VPN: the family console look (Hallow Guard 1.7's "Hallow console"): dark purple-black, the Hallow accent (#F07820 is
         swapped for theme.json's accent, also in its #AARRGGBB forms), lilac secondaries and the family green / amber / red.
         EVERY colour the app uses is a brush in this file (the code only asks for keys), and Mode.LightTheme swaps the values for light mode. -->
    <h:IconConv x:Key="IconConv"/><h:IconVis x:Key="IconVis"/><h:LabelVis x:Key="LabelVis"/><h:IconGap x:Key="IconGap"/>
    <!-- surfaces -->
    <SolidColorBrush x:Key="Bg" Color="#14101B"/>
    <SolidColorBrush x:Key="Side" Color="#110E17"/>
    <SolidColorBrush x:Key="Panel" Color="#1C1726"/>
    <SolidColorBrush x:Key="PanelHi" Color="#221C2E"/>
    <SolidColorBrush x:Key="Well" Color="#120E18"/>
    <SolidColorBrush x:Key="Line" Color="#3A3248"/>
    <SolidColorBrush x:Key="LineDim" Color="#2A2336"/>
    <SolidColorBrush x:Key="BtnBg" Color="#1E1829"/>
    <SolidColorBrush x:Key="BtnLine" Color="#463C58"/>
    <!-- text -->
    <SolidColorBrush x:Key="Text" Color="#ECE8F4"/>
    <SolidColorBrush x:Key="TextSoft" Color="#D6D0E2"/>
    <SolidColorBrush x:Key="Muted" Color="#9790A8"/>
    <SolidColorBrush x:Key="Faint" Color="#6E6684"/>
    <!-- the accent (Hallow) and the family colours -->
    <SolidColorBrush x:Key="AccentBrush" Color="#F07820"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#F59A50"/>
    <SolidColorBrush x:Key="AccentGlow" Color="#33F07820"/>
    <SolidColorBrush x:Key="OnAccent" Color="#1A0E04"/>
    <SolidColorBrush x:Key="Lilac" Color="#A98BE0"/>
    <SolidColorBrush x:Key="LilacDim" Color="#6E5A96"/>
    <SolidColorBrush x:Key="Green" Color="#6ED28C"/>
    <SolidColorBrush x:Key="Amber" Color="#F0BE5A"/>
    <SolidColorBrush x:Key="Red" Color="#E05A64"/>
    <SolidColorBrush x:Key="RedBg" Color="#33E05A64"/>
    <SolidColorBrush x:Key="AmberBg" Color="#2EF0BE5A"/>
    <SolidColorBrush x:Key="GreenBg" Color="#266ED28C"/>
    <SolidColorBrush x:Key="LilacBg" Color="#2EA98BE0"/>
    <!-- list rows: selected and hover -->
    <SolidColorBrush x:Key="RowSel" Color="#3DF07820"/>
    <SolidColorBrush x:Key="RowHover" Color="#1FA98BE0"/>
    <SolidColorBrush x:Key="Blue" Color="#5AB4F0"/>
    <!-- the country-code tile -->
    <SolidColorBrush x:Key="TileBg" Color="#2E2640"/>
    <SolidColorBrush x:Key="TileText" Color="#A98BE0"/>
    <!-- for the old checked/toggle states -->
    <SolidColorBrush x:Key="CheckedBg" Color="#40F07820"/>
    <SolidColorBrush x:Key="CheckedLine" Color="#F07820"/>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="HeadFont">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="NeonFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="#F07820" StrokeThickness="1.5" RadiusX="3" RadiusY="3" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" BasedOn="{StaticResource NeonFocus}"/>

    <!-- Buttons: squared, thin border, glow on hover -->
    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource BtnBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BtnLine}"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2"/>
                        <Border x:Name="hl" Background="#F07820" Opacity="0" CornerRadius="2"/>
                        <StackPanel x:Name="sp" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <Path x:Name="ic" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconConv}}"
                                  Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconVis}}"
                                  Margin="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconGap}}"
                                  Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center"
                                  Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LabelVis}}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hl" Property="Opacity" Value="0.08"/><Setter TargetName="b" Property="BorderBrush" Value="#F07820"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.16"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CheckedBg}"/><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource CheckedLine}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#47F07820" Offset="0"/><GradientStop Color="#24F07820" Offset="1"/></LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#F07820"/>
        <Setter Property="Foreground" Value="#F59A50"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource RedBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- the column headers of the process list: flat, click to sort -->
    <Style x:Key="Head" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" Padding="6,6,6,6"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource PanelHi}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,6,0,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="track" DockPanel.Dock="Left" Width="40" Height="20" CornerRadius="2" Background="{StaticResource BtnBg}" BorderBrush="{StaticResource BtnLine}" BorderThickness="1" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="word" Text="OFF" FontFamily="{StaticResource MonoFont}" FontSize="8.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Border x:Name="knob" Width="12" Height="12" CornerRadius="1" Background="{StaticResource Faint}" HorizontalAlignment="Left" Margin="3,0,3,0"/>
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Green}"/>
                            <Setter TargetName="track" Property="Background" Value="{StaticResource GreenBg}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Background" Value="{StaticResource Green}"/>
                            <Setter TargetName="word" Property="Text" Value="ON"/>
                            <Setter TargetName="word" Property="Foreground" Value="{StaticResource Green}"/>
                            <Setter TargetName="word" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="word" Property="Margin" Value="5,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="#F07820"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Tick" TargetType="CheckBox" BasedOn="{StaticResource Switch}"/>
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="CaretBrush" Value="#F07820"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2" Padding="10,0" MinHeight="30">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#F07820"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource BtnLine}" BorderThickness="1" CornerRadius="2" Padding="4">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="2" Padding="10,6,18,6">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter ContentSource="Icon" Width="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Line}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,4" Background="{StaticResource Line}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Panel}" BorderBrush="#F07820" BorderThickness="1" CornerRadius="2" Padding="10,6" MaxWidth="460"><ContentPresenter/></Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="1" Background="{StaticResource Line}" Margin="3,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource LilacDim}"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource Lilac}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- the page list: an accent bar on the left of the open page -->
    <Style x:Key="Nav" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Margin="0,1">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="#F07820" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource PanelHi}"/></Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="b" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#33F07820" Offset="0"/><GradientStop Color="#00F07820" Offset="1"/></LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
